# ---------------------------------------------------------------------------
# Copy to .env and fill in your own values. Never commit the resulting .env.
# ---------------------------------------------------------------------------

# --- Telegram -------------------------------------------------------------
# Issued by @BotFather
BOT_TOKEN=0000000000:replace-with-your-bot-token

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Storage --------------------------------------------------------------
# supabase = persistent Postgres storage, memory = ephemeral (local/dev only)
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — server-side only, bypasses RLS, keep it out of git
SUPABASE_SERVICE_KEY=replace-with-your-supabase-service-role-key

# --- Behaviour ------------------------------------------------------------
# How many past messages are replayed into the model context
HISTORY_LIMIT=12
# Safety valve for the tool-calling loop
AGENT_MAX_ITERATIONS=5
# Minimum seconds between two messages from the same user
RATE_LIMIT_SECONDS=0.7
LOG_LEVEL=INFO
